{
    "layer": "top",
    "position": "top",
    "height": 34,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["custom/logo"],
    "modules-right": ["custom/bluetooth", "pulseaudio", "clock"],
    
    "custom/logo": {
        "format": "VA-11 HALL-A"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": " 󰥔 {:%Y-%m-%d %H:%M} "
    },

    "custom/bluetooth": {
    "format": "",
    "on-click": "blueman-manager"
    },
    "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
        "headphone": "",
        "headset": "󰋎",
        "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
}
}