{
    "layer": "top",
    "position": "top",
    "height": 34,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["custom/logo"],
    "modules-right": ["network", "cpu", "memory", "clock"],
    
    "custom/logo": {
        "format": "VA-11 HALL-A"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "clock": {
        "format": " [{:%H:%M}] "
    },
    "cpu": {
        "format": "CPU:{usage}%"
    },
    "memory": {
        "format": "RAM:{percentage}%"
    },
    "network": {
        "format-wifi": "NET:{essid}",
        "format-ethernet": "NET:ETH",
        "format-disconnected": "NET:DISC"
    }
}