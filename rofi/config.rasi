@import "/home/karma/.config/theme/rofi-colors.rasi"

/* VA-11 HALL-A */

* {
    background-color: @black;
    font:             "Terminus 12";
}

prompt {
    text-color: @textspecial;
}

configuration {
    show-icons: true;
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
}

window {
    width:            40%;
    location:         center;

    /* Outer blue border */
    background-color: @popborder;
    border:           0px;
    border-radius:    0px;
    padding:          4px;
}

mainbox {
    /* Thin inner white border - KEPT ORIGINAL */
    background-color: @bright;
    padding:          2px;
    spacing:          0px;
}

inputbar {
    children:         [ prompt, entry ];

    /* Black interior */
    background-color: @black;

    border:           0px;
    padding:          6px 8px;
    margin:           0px;

    border-radius:    0px;
}

prompt {
    text-color: @textspecial;
    margin:     0px 6px 0px 0px;
}

entry {
    text-color: @fg;
    background-color: @black;
}

listview {
    background-color: @black;

    lines:            8;
    spacing:          2px;
    scrollbar:        true;

    border:           0px;
    border-radius:    0px;

    padding:          4px 8px 6px 4px;
}

textbox {
    text-color:       @textspecial;  
    background-color: transparent;
    padding:          0px 8px;      
}

/* Force elements to always stay black, overriding Rofi's defaults */
element normal.normal,
element normal.urgent,
element normal.active,
element selected.normal,
element selected.urgent,
element selected.active,
element alternate.normal,
element alternate.urgent,
element alternate.active {
    background-color: @black;
    text-color:       @fg;
}



element {
    background-color: @black;

    orientation: horizontal;
    spacing:     8px;

    padding:     1px 8px;
    margin:      0px 4px;

    border:      0px;
    border-radius: 0px;
}

element-icon {
    size:             1.2em;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    expand:           true;
    text-color:       inherit;
}

element-text selected {
    text-color: @bright;
}

